# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (PostGIS extension required)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=bite_flow_core
DB_POOL_MAX=10

# JWT
ACCESS_TOKEN_SECRET=change_me
REFRESH_TOKEN_SECRET=change_me_too
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Knex migrations (relative to core-service/)
DB_MIGRATION_DIR=src/migrations
DB_MIGRATION_EXTENSION=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mailjet (password reset and member invitation emails)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=no-reply@example.com
MAILJET_FROM_NAME=Bite Flow